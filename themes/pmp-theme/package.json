{
  "name": "pmp-theme-showcase",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "build": "10up-toolkit build",
    "watch": "10up-toolkit watch --port=5000",
    "lint-js": "eslint --no-eslintrc --config eslint-showcase.cjs assets/js includes --ext .js"
  },
  "devDependencies": {
    "10up-toolkit": "5.2.3",
    "terser-webpack-plugin": "5.3.10",
    "webpack": "5.101.3"
  },
  "dependencies": {
    "@10up/block-components": "1.17.6",
    "classnames": "2.5.1",
    "lodash": "4.18.1"
  },
  "10up-toolkit": {
    "useBlockAssets": true,
    "entry": {
      "frontend": "./assets/js/frontend.js",
      "editor": "./assets/js/editor.js"
    }
  },
  "allowScripts": {
    "sharp@0.35.5": true
  },
  "overrides": {
    "postcss": "8.5.33",
    "sharp": "0.35.5",
    "serialize-javascript": "7.1.3",
    "prettier": "2.6.2"
  }
}
