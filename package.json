{
  "name": "wordpress-engineering-showcase",
  "version": "1.0.0",
  "private": true,
  "description": "Isolated historical WordPress feature demonstrations",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "build": "npm --prefix themes/pmp-theme run build",
    "demo:prepare": "node scripts/demo.mjs prepare",
    "demo:start": "node scripts/demo.mjs start",
    "demo:seed": "node scripts/demo.mjs seed",
    "demo:stop": "node scripts/demo.mjs stop",
    "demo:setup": "node scripts/demo.mjs setup",
    "demo:check": "node scripts/demo.mjs check",
    "test": "node --test tests/*.test.mjs",
    "test:browser": "playwright test",
    "lint:php": "node scripts/lint-php.mjs",
    "local:link": "node scripts/local-link.mjs",
    "provenance:check": "node scripts/verify-provenance.mjs"
  },
  "devDependencies": {
    "@wordpress/env": "12.2.0",
    "@playwright/test": "1.58.2"
  },
  "overrides": {
    "isomorphic-git": "1.44.17"
  }
}
